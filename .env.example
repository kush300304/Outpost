# Settings docker-compose.yml reads. Copy to .env (or export them) to override the defaults shown.
# Ports are fixed by docker-compose.yml: router 8080 and dashboard 8090 on the host; edges 8081-8083,
# write-api 9090 and storage 9091 inside the compose network only.

# Edge cache: maximum entries per edge, and how long an entry stays fresh (0 = never expires).
CACHE_CAPACITY=1024
CACHE_TTL_MS=60000
# How long past its ttl an entry may still be served stale while the origin is down (stale-if-error).
CACHE_STALE_IF_ERROR_MS=3600000

# Per-client rate limit at each edge: sustained tokens per second and burst size.
RATE_LIMIT_PER_SEC=100
RATE_LIMIT_BURST=200

# 1 = fsync every write to the storage WAL and the edge queues (durable across power loss).
WAL_FSYNC=1

# 1 = enable write-api's simulated-outage endpoint used by the dashboard.
ADMIN_ENABLED=1

# Log level of every service: trace, debug, info, warn, error, critical or off. Logs go to stdout;
# read them with `docker compose logs -f <service>`. Docker keeps at most 3 x 10 MB per container.
LOG_LEVEL=info
